# ── Server ────────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000

# Comma-separated list of allowed origins for CORS (no trailing slash)
ALLOWED_ORIGINS=http://localhost:3000

# ── Paths ─────────────────────────────────────────────────────────────────────
# Directory where temporary download files are written (created automatically)
TEMP_DIR=./tmp

# ── Download limits ───────────────────────────────────────────────────────────
# Maximum output file size in MB (default 100 MB for free-tier hosting)
MAX_FILE_SIZE_MB=100

# Maximum video duration to allow downloading, in seconds (default 600 = 10 min)
MAX_DURATION_SECONDS=600

# Timeout for the full download operation, in seconds
DOWNLOAD_TIMEOUT_SECONDS=120

# Timeout for the analysis/metadata-fetch step, in seconds
ANALYZE_TIMEOUT_SECONDS=30

# ── Concurrency ───────────────────────────────────────────────────────────────
MAX_CONCURRENT_DOWNLOADS=1

# ── Cleanup ───────────────────────────────────────────────────────────────────
# Temp files older than this many seconds will be deleted by the cleanup task
FILE_TTL_SECONDS=300


# ── Rate limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=60

# ── FFmpeg ────────────────────────────────────────────────────────────────────
# Leave empty to use ffmpeg found on PATH (recommended)
# Set to the full path of the ffmpeg executable if it is not on PATH
FFMPEG_LOCATION=

# ── yt-dlp anti-bot / anti-DRM (YouTube) ─────────────────────────────────────
# Cloud/server IPs are frequently blocked by YouTube's bot detection
# ("Sign in to confirm you're not a bot"). These options help bypass it.

# Custom User-Agent (leave empty to use a built-in realistic browser UA)
YTDLP_USER_AGENT=

# Comma-separated YouTube player clients to try.
# Try "android,ios,web_safari" first, then "web" as a last resort.
# Browser-like clients usually dodge the bot check.
YTDLP_PLAYER_CLIENTS=android,ios,web_safari

# Browser impersonation target for curl_cffi ("chrome" or "safari").
# Requires the curl_cffi package (already in requirements.txt).
YTDLP_IMPERSONATE=chrome

# Path to a Netscape-format cookies file exported from a logged-in browser.
# Only needed for videos that STILL require a login after the above.
# You can mount/upload one, or leave empty to disable.
COOKIES_FILE=

